{
  "name": "prompt-grammar-for-pi",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi extension that proofreads each prompt you send, shows grammar fixes inline, and keeps mistake history for /grammar stats, review, and ask.",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^22.19.19",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
